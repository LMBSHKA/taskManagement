{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/notifications/{userId}/",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5165
        }
      ],
      "UpstreamPathTemplate": "/api/notification/{userId}",
      "UpstreamHttpMethod": [ "GET" ],

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },

      "FileCacheOptions": {
        "TtlSeconds": 800,
        "Region": "notification-cache",
        "EnableContentHashing": false
      }
    },

    {
      "DownstreamPathTemplate": "/api/notifications/{userId}/mark-as-read",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5165
        }
      ],
      "UpstreamPathTemplate": "/api/notification/{userId}",
      "UpstreamHttpMethod": [ "PUT" ],

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },

    {
      "DownstreamPathTemplate": "/api/auth/register/",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5068
        }
      ],
      "UpstreamPathTemplate": "/api/auth/register",
      "UpstreamHttpMethod": [ "POST" ]
    },

    {
      "DownstreamPathTemplate": "/api/auth/login/",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5068
        }
      ],
      "UpstreamPathTemplate": "/api/auth/login",
      "UpstreamHttpMethod": [ "POST" ]
    },

    {
      "DownstreamPathTemplate": "/api/auth/me/",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5068
        }
      ],
      "UpstreamPathTemplate": "/api/auth/me",
      "UpstreamHttpMethod": [ "GET" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },

      "AddHeadersToRequest": {
        "X-User-Id": "Claims[sub]"
      },

      "FileCacheOptions": {
        "TtlSeconds": 3600,
        "Region": "user-cache",
        "EnableContentHashing": false
      }
    },

    {
      "DownstreamPathTemplate": "/api/auth/refresh/",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5068
        }
      ],
      "UpstreamPathTemplate": "/api/auth/refresh",
      "UpstreamHttpMethod": [ "POST" ]
    },

    {
      "DownstreamPathTemplate": "/api/tasks",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5051
        }
      ],
      "UpstreamPathTemplate": "/api/tasks",
      "UpstreamHttpMethod": [ "GET", "POST" ],

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },

      "FileCacheOptions": {
        "TtlSeconds": 800,
        "Region": "task-cache",
        "EnableContentHashing": true
      }
    },

    {
      "DownstreamPathTemplate": "/api/tasks/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5051
        }
      ],
      "UpstreamPathTemplate": "/api/tasks/{id}",
      "UpstreamHttpMethod": [ "GET" ],

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },

      "FileCacheOptions": {
        "TtlSeconds": 800,
        "Region": "task-cache",
        "EnableContentHashing": false
      }
    },

    {
      "DownstreamPathTemplate": "/api/tasks/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5051
        }
      ],
      "UpstreamPathTemplate": "/api/tasks/{id}",
      "UpstreamHttpMethod": [ "PUT", "DELETE" ],

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },

    {
      "DownstreamPathTemplate": "/api/tasks/{id}/assign",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5051
        }
      ],
      "UpstreamPathTemplate": "/api/tasks/{id}/assign",
      "UpstreamHttpMethod": [ "PUT" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    }
  ],

  "GlobalConfiguration": {
    "QoSOptions": {
      "ExceptionsAllowedBeforeBreaking": 3,
      "DurationOfBreak": 7000,
      "TimeoutValue": 3000
    }
  }
}